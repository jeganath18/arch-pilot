{
  "Comment": "ArchPilot end-to-end repository analysis, architecture validation, build, deployment, and fallback workflow",
  "StartAt": "Analyze",
  "States": {
    "Analyze": {
      "Type": "Task",
      "Resource": "${AnalyzeFunctionArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "ArchitectureChoice",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Fail"
        }
      ]
    },
    "ArchitectureChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.analysis.verdict",
          "StringEquals": "native_arm64",
          "Next": "StartBuild"
        },
        {
          "Variable": "$.analysis.verdict",
          "StringEquals": "x86_required",
          "Next": "StartBuild"
        },
        {
          "Variable": "$.analysis.verdict",
          "StringEquals": "ambiguous",
          "Next": "StartAmbiguousX86Build"
        },
        {
          "Variable": "$.analysis.verdict",
          "StringEquals": "unsupported",
          "Next": "Fail"
        }
      ],
      "Default": "Fail"
    },
    "StartAmbiguousX86Build": {
      "Type": "Pass",
      "Result": {
        "verdict": "x86_required",
        "confidence": 0.5,
        "reason": "Ambiguous architecture; deploying using native x86_64."
      },
      "ResultPath": "$.decision",
      "Next": "StartBuild"
    },
    "StartBuild": {
      "Type": "Task",
      "Resource": "${StartBuildFunctionArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitBuild",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Fail"
        }
      ]
    },
    "WaitBuild": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "CheckBuild"
    },
    "CheckBuild": {
      "Type": "Task",
      "Resource": "${CheckBuildFunctionArn}",
      "Next": "BuildChoice",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Fail"
        }
      ]
    },
    "BuildChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.buildStatus",
          "StringEquals": "SUCCEEDED",
          "Next": "PostBuildChoice"
        },
        {
          "Variable": "$.buildStatus",
          "StringEquals": "FAILED",
          "Next": "Fail"
        }
      ],
      "Default": "WaitBuild"
    },
    "PostBuildChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.analysis.verdict",
          "StringEquals": "x86_required",
          "Next": "ValidateArm"
        },
        {
          "Variable": "$.analysis.verdict",
          "StringEquals": "native_arm64",
          "Next": "Deploy"
        }
      ],
      "Default": "Deploy"
    },
    "ValidateArm": {
      "Type": "Task",
      "Resource": "${ValidateArmFunctionArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitArmValidation",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Deploy"
        }
      ]
    },
    "WaitArmValidation": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "CheckArmValidation"
    },
    "CheckArmValidation": {
      "Type": "Task",
      "Resource": "${CheckArmValidationFunctionArn}",
      "Next": "ArmValidationChoice",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Deploy"
        }
      ]
    },
    "ArmValidationChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.validationStatus",
          "StringEquals": "SUCCEEDED",
          "Next": "PrepareArmDeployment"
        },
        {
          "Variable": "$.validationStatus",
          "StringEquals": "FAILED",
          "Next": "PrepareX86Fallback"
        }
      ],
      "Default": "WaitArmValidation"
    },
    "PrepareX86Fallback": {
      "Type": "Pass",
      "Parameters": {
        "jobId.$": "$.jobId",
        "repoUrl.$": "$.repoUrl",
        "analysis.$": "$.analysis",
        "decision.$": "$.decision",
        "buildId.$": "$.buildId",
        "buildStatus.$": "$.buildStatus",
        "imageUri.$": "$.imageUri",
        "targetPlatform": "linux/amd64",
        "containerPort.$": "$.containerPort"
      },
      "ResultPath": "$",
      "Next": "Deploy"
    },
    "PrepareArmDeployment": {
      "Type": "Pass",
      "Parameters": {
        "targetPlatform": "linux/arm64",
        "imageUri.$": "$.armImageUri"
      },
      "ResultPath": "$.deployment",
      "Next": "ApplyArmDeployment"
    },
    "ApplyArmDeployment": {
      "Type": "Pass",
      "Parameters": {
        "jobId.$": "$.jobId",
        "repoUrl.$": "$.repoUrl",
        "analysis.$": "$.analysis",
        "decision": {
          "verdict.$": "$.analysis.verdict",
          "confidence.$": "$.analysis.confidence"
        },
        "buildId.$": "$.buildId",
        "buildStatus.$": "$.buildStatus",
        "imageUri.$": "$.deployment.imageUri",
        "targetPlatform.$": "$.deployment.targetPlatform",
        "containerPort.$": "$.containerPort"
      },
      "ResultPath": "$",
      "Next": "Deploy"
    },
    "Deploy": {
      "Type": "Task",
      "Resource": "${DeployFunctionArn}",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 3,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "WaitDeploy",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Fail"
        }
      ]
    },
    "WaitDeploy": {
      "Type": "Wait",
      "Seconds": 15,
      "Next": "CheckDeploy"
    },
    "CheckDeploy": {
      "Type": "Task",
      "Resource": "${CheckDeployFunctionArn}",
      "Next": "DeployChoice",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Fail"
        }
      ]
    },
    "DeployChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.deployStatus",
          "StringEquals": "HEALTHY",
          "Next": "Report"
        },
        {
          "Variable": "$.deployStatus",
          "StringEquals": "FAILED",
          "Next": "Fail"
        }
      ],
      "Default": "WaitDeploy"
    },
    "Report": {
      "Type": "Task",
      "Resource": "${ReportFunctionArn}",
      "Next": "Success",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "Fail"
        }
      ]
    },
    "Success": {
      "Type": "Succeed"
    },
    "Fail": {
      "Type": "Fail",
      "Cause": "ArchPilot workflow failed; inspect the job record and CloudWatch logs."
    }
  }
}